/* pages/index/index.wxss */
/* 首页特殊布局：全屏垂直居中 */

page {
  height: 100%;
}

.container {
  display: flex;
  flex-direction: column;
  height: 100%;
  padding: 0 32rpx;
}

.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 120rpx;
  flex-shrink: 0;
}

.app-name {
  font-size: 56rpx;
  font-weight: 700;
  color: var(--primary);
  letter-spacing: 8rpx;
}

.app-desc {
  font-size: 28rpx;
  color: #888;
  margin-top: 12rpx;
}

.content {
  flex: 1;
  width: 100%;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.trip-list {
  width: 100%;
  overflow-y: auto;
  padding: 24rpx 0;
}

.trip-card {
  padding: 28rpx 32rpx;
}

.trip-name {
  font-size: 32rpx;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.trip-info {
  font-size: 26rpx;
  color: #888;
}

.actions {
  width: 100%;
  padding: 40rpx 0 calc(56rpx + env(safe-area-inset-bottom));
  flex-shrink: 0;
}

.actions .btn-primary {
  margin-bottom: 24rpx;
}

.actions .btn-secondary {
  margin-bottom: 0;
}
