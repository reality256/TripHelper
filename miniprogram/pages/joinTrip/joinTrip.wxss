/* pages/joinTrip/joinTrip.wxss */

.page-title { margin-bottom: 12rpx; }
.page-subtitle { margin-bottom: 56rpx; }

/* 输入区域容器：点击时聚焦隐藏 input */
.code-area {
  position: relative;
  display: flex;
  justify-content: center;
  margin-bottom: 56rpx;
}

/* 隐藏 input：移出可视区域，不可见但可接收输入 */
.code-input {
  position: absolute;
  left: -9999rpx;
  top: -9999rpx;
  width: 1rpx;
  height: 1rpx;
  opacity: 0;
}

/* 展示格子层 */
.code-box-row {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  position: relative;
  z-index: 1;
}

.code-box {
  width: 88rpx;
  height: 100rpx;
  background: #F5F7F6;
  border-radius: 14rpx;
  border: 3rpx solid #E8E8E8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 700;
  color: #1A1A1A;
  box-sizing: border-box;
}

.code-box.active {
  border-color: var(--primary);
}

.code-box.filled {
  background: #E8F5F3;
  border-color: var(--primary);
  color: var(--primary);
}

.btn-disabled {
  opacity: 0.4;
  pointer-events: none;
}
