<!--pages/settlement/settlement.wxml-->
<view class="container">
  <view class="page-title">结算结果</view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!loading && balances.length === 0}}">
    <view class="empty-state-icon">🧾</view>
    <view class="empty-state-text">还没有结算数据</view>
    <view class="empty-state-text">添加账单后，系统将自动计算分摊结果</view>
  </view>

  <block wx:if="{{balances.length > 0}}">

    <!-- 每人收支明细 -->
    <view class="section-title">收支明细</view>
    <view class="balance-list">
      <view class="card balance-card" wx:for="{{balances}}" wx:key="openid">
        <view class="balance-top">
          <text class="balance-name">{{item.nickName}}</text>
          <text class="balance-net {{item.netClass}}">{{item.netText}}</text>
        </view>
        <view class="balance-detail">
          <text class="balance-label">实付</text>
          <text class="balance-value">¥{{item.paidText}}</text>
          <text class="balance-label balance-label-gap">应付</text>
          <text class="balance-value">¥{{item.shouldPayText}}</text>
        </view>
      </view>
    </view>

    <!-- 转账方案 -->
    <view class="section-title" wx:if="{{transfers.length > 0}}">结算方案</view>

    <view class="card" wx:if="{{transfers.length === 0}}">
      <view class="settled-text">🎉 无需转账，账目已结清</view>
    </view>

    <view class="transfer-list" wx:if="{{transfers.length > 0}}">
      <view class="card transfer-card" wx:for="{{transfers}}" wx:key="index">
        <view class="transfer-flow">
          <text class="transfer-from">{{item.fromName}}</text>
          <text class="transfer-arrow">→</text>
          <text class="transfer-to">{{item.toName}}</text>
        </view>
        <view class="transfer-amount">¥{{item.amountText}}</view>
      </view>
    </view>

  </block>

  <!-- 加载中 -->
  <view class="loading" wx:if="{{loading}}">
    <text>计算中...</text>
  </view>
</view>