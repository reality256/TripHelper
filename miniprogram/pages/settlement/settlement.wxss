/* pages/settlement/settlement.wxss */

.section-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 16rpx;
  margin-top: 8rpx;
}

/* 收支明细 */
.balance-list {
  margin-bottom: 8rpx;
}

.balance-card {
  padding: 28rpx 32rpx;
}

.balance-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.balance-name {
  font-size: 30rpx;
  font-weight: 500;
}

.balance-net {
  font-size: 30rpx;
  font-weight: 600;
}

.net-positive {
  color: var(--primary);
}

.net-negative {
  color: var(--danger);
}

.balance-detail {
  display: flex;
  align-items: center;
}

.balance-label {
  font-size: 24rpx;
  color: #999;
}

.balance-label-gap {
  margin-left: 32rpx;
}

.balance-value {
  font-size: 26rpx;
  color: #666;
  margin-left: 8rpx;
}

/* 已结清 */
.settled-text {
  text-align: center;
  font-size: 30rpx;
  color: #666;
  padding: 20rpx 0;
}

/* 转账方案 */
.transfer-list {
  margin-bottom: 32rpx;
}

.transfer-card {
  padding: 28rpx 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.transfer-flow {
  display: flex;
  align-items: center;
  font-size: 28rpx;
}

.transfer-from {
  color: var(--danger);
}

.transfer-arrow {
  margin: 0 16rpx;
  color: #CCC;
  font-size: 32rpx;
}

.transfer-to {
  color: var(--primary);
}

.transfer-amount {
  font-size: 32rpx;
  font-weight: 700;
}
