/* pages/addExpense/addExpense.wxss */

.page-title {
  margin-bottom: 40rpx;
}

.card {
  margin-bottom: 56rpx;
}

.form-hint {
  font-size: 22rpx;
  color: #CCC;
  margin-top: 6rpx;
}

/* 类型切换 */
.type-switch {
  display: flex;
  gap: 0;
  border-radius: 14rpx;
  overflow: hidden;
  border: 2rpx solid #E8E8E8;
}

.type-tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #999;
  background: #F5F7F6;
}

.type-tab:active { background: #E8ECEA; }

.type-active {
  background: #FFF;
  color: #E67E22;
  font-weight: 600;
}

.type-active.type-income {
  color: #27AE60;
}

/* 成员选择 */
.member-select {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.member-tag {
  display: flex;
  align-items: center;
  background: #F5F7F6;
  border-radius: 14rpx;
  padding: 16rpx 24rpx;
}

.member-tag:active {
  background: #E8ECEA;
}

.member-check {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 3rpx solid #D0D0D0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
  font-size: 22rpx;
  color: #FFF;
  flex-shrink: 0;
}

.member-check.checked {
  background: var(--primary);
  border-color: var(--primary);
}

.member-check.is-multi {
  border-radius: 8rpx;
}

.member-tag-name {
  font-size: 28rpx;
}

.member-tag-avg {
  font-size: 24rpx;
  color: #999;
  margin-left: 12rpx;
}

.split-hint {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #999;
}

/* 分类标签 */
.category-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.category-tag {
  padding: 14rpx 28rpx;
  background: #F5F7F6;
  border-radius: 14rpx;
  font-size: 26rpx;
  color: #666;
  border: 2rpx solid transparent;
}

.category-tag:active {
  background: #E8ECEA;
}

.category-tag.cat-active {
  background: #E8F5F3;
  border-color: var(--primary);
  color: var(--primary);
  font-weight: 500;
}
