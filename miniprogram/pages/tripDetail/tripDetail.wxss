/* pages/tripDetail/tripDetail.wxss */

.container {
  padding: 32rpx;
}

/* 旅行信息 */
.trip-header {
  padding: 40rpx 32rpx;
}

.trip-name {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.trip-destination {
  font-size: 30rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.trip-dates {
  font-size: 26rpx;
  color: #888;
  margin-bottom: 20rpx;
}

.trip-stats {
  font-size: 26rpx;
  color: #888;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--border);
}

.trip-stats-sep {
  margin: 0 16rpx;
}

/* 功能菜单 */
.menu-card {
  padding: 0;
  overflow: hidden;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #F5F5F5;
  font-size: 30rpx;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background: #F9F9F9;
}

.arrow {
  color: #CCC;
  font-size: 40rpx;
  font-weight: 300;
}

/* 邀请码 */
.invite-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 32rpx;
}

.invite-box:active {
  background: #F9F9F9;
}

.invite-label {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.invite-code {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--primary);
  letter-spacing: 12rpx;
  margin-bottom: 12rpx;
}

.invite-tip {
  font-size: 24rpx;
  color: #BBB;
}
