<!--pages/tripDetail/tripDetail.wxml-->
<view class="container" wx:if="{{!loading && trip}}">

  <!-- 旅行基本信息 -->
  <view class="card trip-header">
    <view class="trip-name">{{trip.name}}</view>
    <view class="trip-destination">📍 {{trip.destination}}</view>
    <view class="trip-dates">📅 {{trip.startDate}} 至 {{trip.endDate}}</view>
    <view class="trip-stats">
      <text>{{members.length}} 位成员</text>
      <text class="trip-stats-sep">|</text>
      <text>¥{{expenseSummary.totalAmount || '0.00'}} 总账单</text>
    </view>
  </view>

  <!-- 功能入口 -->
  <view class="card menu-card">
    <view class="menu-item" bindtap="goItinerary">
      <text>📋 行程管理</text><text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goExpenses">
      <text>💰 账单管理</text><text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goSettlement">
      <text>🧾 结算结果</text><text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goMembers">
      <text>👥 成员管理</text><text class="arrow">›</text>
    </view>
  </view>

  <!-- 邀请码 -->
  <view class="card invite-box" bindtap="copyInviteCode">
    <text class="invite-label">邀请码</text>
    <text class="invite-code">{{trip.inviteCode}}</text>
    <text class="invite-tip">点击复制邀请码分享给朋友</text>
  </view>

</view>

<!-- 加载中 -->
<view class="loading" wx:if="{{loading}}">
  <text>加载中...</text>
</view>