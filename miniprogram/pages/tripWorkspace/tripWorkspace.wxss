/* pages/tripWorkspace/tripWorkspace.wxss */

page {
  height: 100%;
}

.workspace {
  display: flex;
  flex-direction: column;
  height: 100%;
}

/* 顶部旅行信息 */
.top-bar {
  padding: 24rpx 32rpx 20rpx;
  background: #FFF;
  border-bottom: 1rpx solid #F0F0F0;
  flex-shrink: 0;
}

.top-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-bottom: 6rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.top-meta {
  font-size: 24rpx;
  color: #999;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 内容区 */
.tab-content {
  flex: 1;
  /* 关键：scroll-view 在 flex 布局中会被内容撑开（高度不收缩），
     必须显式给 height: 0 强制其以 flex 分配的剩余空间为准，否则底部栏被顶下去 */
  height: 0;
  background: #F5F7F6;
  padding: 24rpx 0 0;
}

/* ===== 行程 tab ===== */

/* 行程区域标题行：左侧标题 + 右侧地图入口 */
.itin-section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 24rpx 16rpx;
}

.itin-section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.itin-map-link {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: var(--primary);
  flex-shrink: 0;
}

.itin-map-link:active { opacity: 0.7; }

.itin-map-arrow {
  font-size: 28rpx;
  margin-left: 4rpx;
  color: var(--primary);
}

/* 列表视图 */
.itin-list {
  padding: 0 24rpx;
}

.itin-group {
  margin-bottom: 8rpx;
}

.itin-date {
  font-size: 26rpx;
  font-weight: 500;
  color: #666;
  padding: 8rpx 8rpx 12rpx;
}

.itin-card {
  padding: 24rpx 28rpx;
  margin-bottom: 8rpx;
}

.itin-card.itin-ended {
  opacity: 0.55;
}

.itin-card.itin-active {
  border-left: 6rpx solid var(--primary);
  background: #FAFFFE;
}

.itin-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.itin-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.itin-index {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--primary);
  background: #E8F5F3;
  border-radius: 50%;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 14rpx;
}

.itin-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #1A1A1A;
  flex: 1;
  min-width: 0;
}

.itin-status {
  font-size: 20rpx;
  color: #FFF;
  background: var(--primary);
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  margin-left: 10rpx;
  flex-shrink: 0;
}

.itin-status-upcoming {
  background: #E67E22;
}

.itin-right {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.itin-time {
  font-size: 24rpx;
  color: #888;
  white-space: nowrap;
}

.itin-del {
  width: 72rpx;
  height: 40rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.itin-del::before,
.itin-del::after {
  content: '';
  position: absolute;
  width: 26rpx;
  height: 3rpx;
  background: #CCC;
  border-radius: 1rpx;
}

.itin-del::before { transform: rotate(45deg); }
.itin-del::after  { transform: rotate(-45deg); }

.itin-del:active::before,
.itin-del:active::after {
  background: var(--danger, #E74C3C);
}

.itin-row {
  font-size: 24rpx;
  color: #888;
  margin-top: 8rpx;
  margin-left: 54rpx;
}

.itin-conflict {
  color: #E67E22;
  font-size: 22rpx;
  display: flex;
  align-items: flex-start;
}

.itin-note {
  font-size: 22rpx;
  color: #BBB;
  margin-top: 6rpx;
  margin-left: 54rpx;
  padding-top: 10rpx;
  border-top: 1rpx solid #F5F5F5;
}

/* 底部操作按钮 */
.tab-action {
  padding: 24rpx 24rpx 40rpx;
}

.tab-action-row {
  display: flex;
  gap: 24rpx;
}

.btn-half {
  flex: 1;
  min-width: 0;
}

/* ===== 账单 tab ===== */

/* ===== 预算总览卡片 ===== */
.budget-overview {
  margin: 0 24rpx 16rpx;
  background: #FFF;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(26, 26, 26, 0.04);
}

.budget-overview.bo-over-budget {
  /* 超预算时保留默认样式，进度说明区变色即可 */
}

/* 卡片头部：标题 + 设置按钮 */
.bo-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.bo-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.bo-edit-btn {
  font-size: 24rpx;
  color: var(--primary);
  padding: 6rpx 18rpx;
  border: 1rpx solid var(--primary);
  border-radius: 20rpx;
  flex-shrink: 0;
}

.bo-edit-btn:active { opacity: 0.7; }

/* 金额区：已花费 + 总预算 双列 */
.bo-amounts {
  display: flex;
  margin-bottom: 24rpx;
}

.bo-amount-block {
  flex: 1;
}

.bo-amount-right {
  text-align: right;
}

.bo-amount-label {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-bottom: 8rpx;
}

.bo-amount-value {
  font-weight: 700;
  display: block;
}

.bo-amount-spent {
  font-size: 48rpx;
  color: var(--primary);
  line-height: 1.1;
}

.bo-amount-spent.bo-over-color {
  color: #E74C3C;
}

.bo-amount-budget {
  font-size: 34rpx;
  color: #666;
  padding-top: 14rpx;
}

/* 进度条 */
.bo-bar-wrap {
  height: 8rpx;
  background: #F0F0F0;
  border-radius: 4rpx;
  margin-bottom: 12rpx;
  overflow: hidden;
}

.bo-bar-inner {
  height: 100%;
  border-radius: 4rpx;
  transition: width 0.3s;
  max-width: 100%;
}

/* 进度说明 */
.bo-bottom-row {
  font-size: 24rpx;
  color: #999;
  text-align: center;
}

.bo-bottom-num {
  font-weight: 500;
  color: #666;
}

.bo-over-text {
  color: #E74C3C;
}

/* 无预算提示（ui-banner 提供基础样式） */
.budget-empty {
  margin: 32rpx 24rpx 24rpx;
  background: #FFF;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.be-text {
  font-size: 24rpx;
  color: #999;
}

.be-link {
  font-size: 24rpx;
  color: var(--primary);
  padding: 6rpx 16rpx;
  border: 1rpx solid var(--primary);
  border-radius: 16rpx;
  flex-shrink: 0;
}

.be-link:active { opacity: 0.7; }

/* 顶部操作区 */
.expense-top-bar {
  padding: 20rpx 24rpx 20rpx;
}

.expense-summary {
  text-align: center;
  padding: 32rpx 0 20rpx;
}

.expense-overview-title {
  font-size: 26rpx;
  font-weight: 500;
  color: #666;
  display: block;
  margin-bottom: 6rpx;
}

.expense-overview-info {
  font-size: 24rpx;
  color: #BBB;
}

.expense-sum-label {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--primary);
}

.expense-sum-count {
  font-size: 24rpx;
  color: #BBB;
}

.expense-top-actions {
  display: flex;
  gap: 16rpx;
}

.expense-top-actions .btn-sm {
  flex: 1;
  min-width: 0;
}

/* 小按钮 */
.btn-sm {
  height: 72rpx;
  font-size: 26rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
}

/* 结算过期提示（ui-banner--warning 提供基础样式） */
.stale-banner {
  margin: 16rpx 24rpx;
  display: flex;
  align-items: flex-start;
}

/* 结算未计算提示 */
.settle-placeholder {
  margin: 40rpx 24rpx;
  text-align: center;
  font-size: 26rpx;
  color: #CCC;
}

/* 账单列表 */
.expense-list {
  padding: 0 24rpx;
}

.expense-card {
  padding: 24rpx 28rpx;
}

.expense-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 6rpx;
}

.expense-title-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex: 1;
  min-width: 0;
}

.expense-cat-tag {
  font-size: 20rpx;
  color: var(--primary);
  background: #E8F5F3;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
  white-space: nowrap;
}

.expense-title {
  font-size: 28rpx;
  font-weight: 500;
  flex: 1;
}

.expense-amount {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--primary);
  flex-shrink: 0;
  margin-left: 24rpx;
}

.expense-amount.income-amount {
  color: #E74C3C;
}

.expense-meta {
  font-size: 22rpx;
  color: #999;
}

.expense-date {
  color: #BBB;
}

.expense-note {
  font-size: 22rpx;
  color: #BBB;
  margin-top: 6rpx;
  padding-top: 10rpx;
  border-top: 1rpx solid #F5F5F5;
}

/* 账单卡片可点击进入详情 */
.expense-card-tap:active {
  background: #F9F9F9;
}

/* 结算 */
.settle-section {
  padding: 0 24rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin: 24rpx 0 12rpx;
}

.settle-card {
  padding: 24rpx 28rpx;
  margin-bottom: 8rpx;
}

.settle-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 4rpx;
}

.settle-name {
  font-size: 28rpx;
  font-weight: 500;
}

.settle-net {
  font-size: 28rpx;
  font-weight: 600;
}

.settle-detail {
  font-size: 22rpx;
  color: #999;
}

.settle-done {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #666;
}

/* 转账 */
.transfer-card {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  margin-bottom: 8rpx;
  font-size: 28rpx;
}

.tf-from { color: var(--danger); }
.tf-arrow { color: #CCC; }
.tf-to   { color: var(--primary); }
.tf-amount {
  margin-left: auto;
  font-weight: 700;
  font-size: 30rpx;
}

.net-positive { color: var(--primary); }
.net-negative { color: var(--danger); }

/* ===== 待办 tab ===== */

.todo-filter-bar {
  display: flex;
  padding: 0 24rpx 16rpx;
  gap: 12rpx;
}

.todo-section {
  padding: 0 24rpx;
}

.todo-card {
  padding: 24rpx 28rpx;
  margin-bottom: 8rpx;
}

.todo-done {
  opacity: 0.55;
}

.todo-header {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.todo-check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 3rpx solid #D0D0D0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}

/* CSS 对勾 — todo 完成态 */
.todo-done .todo-check::after {
  content: '';
  display: block;
  width: 12rpx;
  height: 20rpx;
  border-right: 3rpx solid #FFF;
  border-bottom: 3rpx solid #FFF;
  transform: rotate(45deg);
  margin-top: -4rpx;
}

.todo-check:active {
  background: var(--primary);
  border-color: var(--primary);
}

.todo-done .todo-check {
  background: var(--primary);
  border-color: var(--primary);
}

.todo-title {
  font-size: 28rpx;
  font-weight: 500;
  flex: 1;
}

.todo-del {
  width: 72rpx;
  height: 40rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.todo-del::before,
.todo-del::after {
  content: '';
  position: absolute;
  width: 26rpx;
  height: 3rpx;
  background: #CCC;
  border-radius: 1rpx;
}

.todo-del::before { transform: rotate(45deg); }
.todo-del::after  { transform: rotate(-45deg); }

.todo-del:active::before,
.todo-del:active::after {
  background: var(--danger, #E74C3C);
}

.todo-meta {
  font-size: 22rpx;
  color: #999;
  margin-left: 56rpx;
  margin-bottom: 2rpx;
}

.todo-done-time {
  color: var(--primary);
}

.todo-note {
  font-size: 22rpx;
  color: #BBB;
  margin-left: 56rpx;
  margin-top: 4rpx;
  padding-top: 8rpx;
  border-top: 1rpx solid #F5F5F5;
}

/* ===== 设置 tab ===== */
.settings-tab {
  padding: 0 24rpx;
}

.set-section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #999;
  margin: 24rpx 0 12rpx 8rpx;
}

/* 成员 */
.member-card {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  margin-bottom: 8rpx;
}

.member-avatar-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  overflow: hidden;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.member-avatar-img {
  width: 100%;
  height: 100%;
}

.member-avatar-placeholder {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #E8F5F3;
  color: var(--primary);
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.member-info {
  font-size: 28rpx;
  display: flex;
  align-items: center;
}

.member-badge {
  font-size: 20rpx;
  color: var(--primary);
  border: 1rpx solid var(--primary);
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  margin-left: 12rpx;
}

.member-me {
  font-size: 20rpx;
  color: #999;
  background: #F0F0F0;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  margin-left: 8rpx;
}

.member-remove-btn {
  font-size: 22rpx;
  color: #E74C3C;
  margin-left: auto;
  flex-shrink: 0;
  padding: 6rpx 14rpx;
}

.member-remove-btn:active { opacity: 0.6; }

/* 邀请码 */
.invite-card {
  text-align: center;
  padding: 32rpx;
}

.invite-card:active {
  background: #F9F9F9;
}

.invite-code-text {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--primary);
  letter-spacing: 10rpx;
  display: block;
  margin-bottom: 8rpx;
}

.invite-hint {
  font-size: 22rpx;
  color: #BBB;
}

/* 切换旅行 */
.switch-card {
  padding: 24rpx 28rpx;
  margin-bottom: 8rpx;
}

.switch-card:active {
  background: #F9F9F9;
}

.switch-name {
  font-size: 28rpx;
  font-weight: 500;
  display: block;
  margin-bottom: 4rpx;
}

.switch-detail {
  font-size: 22rpx;
  color: #999;
}

/* ===== 加载状态（ui-loading 提供基础样式） ===== */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 32rpx;
  color: #999;
  font-size: 26rpx;
}

/* ===== 错误状态（ui-error 提供基础样式） ===== */
.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 32rpx;
}

.error-state-icon {
  margin-bottom: 16rpx;
}

.error-state-text {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 28rpx;
}

/* ===== 旅行管理（解散/退出） ===== */
.danger-card {
  padding: 24rpx 28rpx;
  margin-bottom: 8rpx;
}

.danger-desc {
  font-size: 24rpx;
  color: #999;
  line-height: 1.6;
  margin-bottom: 4rpx;
}

.btn-danger {
  margin-top: 20rpx;
  width: 100%;
  height: 88rpx;
  background: #FFF;
  border: 2rpx solid #E74C3C;
  border-radius: 14rpx;
  color: #E74C3C;
  font-size: 30rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.btn-danger:active {
  background: #E74C3C;
  color: #FFF;
}

/* ===== 个人资料卡片 ===== */
.profile-card {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  margin-bottom: 8rpx;
}

.profile-card:active {
  background: #F9F9F9;
}

.profile-avatar-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  overflow: hidden;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.profile-avatar {
  width: 100%;
  height: 100%;
}

.profile-info {
  display: flex;
  flex-direction: column;
}

.profile-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #1A1A1A;
  margin-bottom: 4rpx;
}

.profile-hint {
  font-size: 22rpx;
  color: #BBB;
}

/* ===== 资料编辑弹窗 ===== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
}

.modal-panel {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 580rpx;
  background: #FFF;
  border-radius: 24rpx;
  padding: 48rpx 40rpx 36rpx;
  z-index: 101;
  text-align: center;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-bottom: 12rpx;
}

.modal-desc {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 36rpx;
  line-height: 1.5;
}

/* 头像选择：容器包裹展示层 + 透明 button */
.avatar-picker-wrap {
  position: relative;
  width: 140rpx;
  height: 140rpx;
  margin: 0 auto 32rpx;
  border-radius: 50%;
  overflow: hidden;
}

.avatar-preview {
  display: block;
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
}

.avatar-placeholder {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: #F0F0F0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #BBB;
  border: 2rpx dashed #D0D0D0;
  box-sizing: border-box;
}

/* 透明 button 覆盖整个容器，接收 open-type="chooseAvatar" 事件 */
.avatar-picker-btn {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  z-index: 2;
  padding: 0;
  margin: 0;
  border: none;
  border-radius: 50%;
  background: transparent;
}

.avatar-picker-btn::after {
  border: none;
}

.modal-input-wrap {
  margin-bottom: 36rpx;
}

.modal-input {
  width: 100%;
  height: 88rpx;
  background: #F5F7F6;
  border-radius: 14rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  text-align: center;
  box-sizing: border-box;
}

.modal-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* 底部菜单栏 */
.bottom-bar {
  display: flex;
  background: #FFF;
  border-top: 1rpx solid #F0F0F0;
  padding-bottom: env(safe-area-inset-bottom);
  flex-shrink: 0;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 22rpx 0;
  margin: 6rpx 8rpx;
  border-radius: 16rpx;
}

.tab-icon {
  width: 40rpx;
  height: 40rpx;
  margin-bottom: 4rpx;
}

.tab-label {
  font-size: 28rpx;
  color: #999;
}

.tab-item.active {
  background: var(--primary);
}

.tab-item.active .tab-label {
  color: #FFF;
  font-weight: 500;
}

/* ===== 页面级 loading / error ===== */
.page-error {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
  padding: 48rpx;
}

.page-error-icon {
  margin-bottom: 20rpx;
}

.page-error-text {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 32rpx;
  text-align: center;
}
