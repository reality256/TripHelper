<!--pages/tripWorkspace/tripWorkspace.wxml-->
<view class="workspace" wx:if="{{!loading && trip}}">

  <!-- 顶部旅行信息 -->
  <view class="top-bar">
    <view class="top-name">{{trip.name}}</view>
    <view class="top-meta"> {{trip.destination}} · {{trip.startDate}} - {{trip.endDate}} · {{memberCount}}人</view>
  </view>

  <!-- 内容区（scroll-view + refresher 支持下拉刷新） -->
  <scroll-view class="tab-content" scroll-y refresher-enabled refresher-background="#F5F7F6" refresher-triggered="{{refresherTriggered}}" bindrefresherrefresh="onPullDownRefresh">

    <!-- ===== 行程 tab ===== -->
    <block wx:if="{{activeTab === 'itinerary'}}">

      <!-- 加载中 -->
      <view class="loading-state ui-loading" wx:if="{{itineraryLoading}}">
        <view class="loading-spinner ui-loading-spinner"></view>
        <text>正在加载行程...</text>
      </view>

      <!-- 加载失败 -->
      <view class="error-state ui-error" wx:elif="{{itineraryError}}">
        <view class="error-state-icon"><icon type="warn" size="44" color="#E6A23C"/></view>
        <view class="error-state-text">{{itineraryError}}</view>
        <view class="btn-secondary" bindtap="retryLoadItinerary">重试</view>
      </view>

      <!-- 空状态 -->
      <view class="empty-state" wx:elif="{{itineraryLoaded && itineraryEmpty}}">
        <view class="empty-state-text">暂无行程安排</view>
      </view>

      <!-- 空状态时直接显示添加按钮 -->
      <view class="tab-action" wx:if="{{itineraryLoaded && itineraryEmpty}}">
        <view class="btn-primary" bindtap="goAddItinerary">添加行程</view>
      </view>

      <!-- 行程标题行 -->
      <block wx:if="{{itineraryLoaded && !itineraryEmpty}}">
      <view class="itin-section-header">
        <text class="itin-section-title">行程安排</text>
        <view class="itin-map-link" bindtap="goScheduleMap">
          <text>地图总览</text>
          <text class="itin-map-arrow">›</text>
        </view>
      </view>

      <!-- 列表视图 -->
      <view class="itin-list">
        <view class="itin-group" wx:for="{{itineraryGroups}}" wx:key="date">
          <view class="itin-date">{{item.date}}</view>
          <view class="card itin-card {{row.isEnded ? 'itin-ended' : ''}} {{row.showActive ? 'itin-active' : ''}}" wx:for="{{item.items}}" wx:for-item="row" wx:key="_id" data-id="{{row._id}}" bindtap="goEditItinerary">
            <view class="itin-header">
              <view class="itin-left">
                <text class="itin-index">{{row.dailyIndex}}</text>
                <text class="itin-title">{{row.title}}</text>
                <text class="itin-status" wx:if="{{row.isOngoing}}">进行中</text>
                <text class="itin-status itin-status-upcoming" wx:elif="{{row.showActive}}">即将开始</text>
              </view>
              <view class="itin-right">
                <text class="itin-time" wx:if="{{row.timeText && !itineraryManaging}}">{{row.timeText}}</text>
                <view class="itin-del" wx:if="{{itineraryManaging}}" data-id="{{row._id}}" bindtap="deleteItinerary"></view>
              </view>
            </view>
            <view class="itin-row" wx:if="{{row.location}}">地址：{{row.location}}</view>
            <view class="itin-row itin-conflict" wx:if="{{row.hasConflict}}">
              <icon type="warn" size="16" color="#D97706" style="flex-shrink:0;margin-top:2rpx"/>
              <text style="margin-left:8rpx">时间冲突：与「{{row.conflictNames}}」重叠</text>
            </view>
            <view class="itin-note" wx:if="{{row.note}}">{{row.note}}</view>
          </view>
        </view>
      </view>

      <!-- 操作区 -->
      <view class="tab-action" wx:if="{{!itineraryManaging}}">
        <view class="btn-primary" bindtap="toggleItineraryManage">管理行程</view>
      </view>
      <view class="tab-action tab-action-row" wx:if="{{itineraryManaging}}">
        <view class="btn-primary btn-half" bindtap="goAddItinerary">添加行程</view>
        <view class="btn-secondary btn-half" bindtap="toggleItineraryManage">完成</view>
      </view>
      </block><!-- end itineraryLoaded -->
    </block>

    <!-- ===== 账单 tab ===== -->
    <block wx:if="{{activeTab === 'expenses'}}">

      <!-- 加载中 -->
      <view class="loading-state ui-loading" wx:if="{{expensesLoading}}">
        <view class="loading-spinner ui-loading-spinner"></view>
        <text>正在加载账单...</text>
      </view>

      <!-- 加载失败 -->
      <view class="error-state ui-error" wx:elif="{{expensesError}}">
        <view class="error-state-icon"><icon type="warn" size="44" color="#E6A23C"/></view>
        <view class="error-state-text">{{expensesError}}</view>
        <view class="btn-secondary" bindtap="retryLoadExpenses">重试</view>
      </view>

      <block wx:if="{{expensesLoaded}}">

      <!-- 预算总览卡片（已设置预算时靠上展示） -->
      <view class="budget-overview {{budgetSummary.isOverBudget ? 'bo-over-budget' : ''}}" wx:if="{{budgetLoaded && budgetSummary.hasBudget}}">
        <view class="bo-header">
          <text class="bo-title">旅行预算</text>
          <text class="bo-edit-btn" wx:if="{{trip.creatorOpenid === myOpenid}}" bindtap="goBudgetSetting">设置</text>
        </view>

        <view class="bo-amounts">
          <view class="bo-amount-block">
            <text class="bo-amount-label">已花费</text>
            <text class="bo-amount-value bo-amount-spent {{budgetSummary.isOverBudget ? 'bo-over-color' : ''}}">¥{{budgetSummary.totalExpense}}</text>
          </view>
          <view class="bo-amount-block bo-amount-right">
            <text class="bo-amount-label">总预算</text>
            <text class="bo-amount-value bo-amount-budget">¥{{budgetSummary.totalBudget}}</text>
          </view>
        </view>

        <view class="bo-bar-wrap">
          <view class="bo-bar-inner" style="width: {{budgetSummary.usageRate > 100 ? 100 : budgetSummary.usageRate}}%; background: {{budgetSummary.isOverBudget ? '#E74C3C' : 'var(--primary)'}};"></view>
        </view>

        <view class="bo-bottom-row">
          <text wx:if="{{!budgetSummary.isOverBudget}}">剩余 <text class="bo-bottom-num">¥{{budgetSummary.remainingBudget}}</text> · 已使用 {{budgetSummary.usageRate}}%</text>
          <text class="bo-over-text" wx:if="{{budgetSummary.isOverBudget}}">已超出 <text class="bo-bottom-num">¥{{budgetSummary.overBudget}}</text> · 已使用 {{budgetSummary.usageRate}}%</text>
        </view>
      </view>

      <!-- 顶部操作区 -->
      <!-- 已设置预算时：轻量概览，不重复显示总消费 -->
      <view class="expense-top-bar" wx:if="{{budgetLoaded && budgetSummary.hasBudget}}">
        <view class="expense-top-actions">
          <view class="btn-primary btn-sm" bindtap="goAddExpense">添加账单</view>
          <view class="btn-secondary btn-sm {{expenseEmpty ? 'btn-disabled' : ''}}" bindtap="onCalculateSettlement">计算结算</view>
        </view>
        <view class="expense-summary" wx:if="{{!expenseEmpty}}">
          <text class="expense-overview-title">账单概览</text>
          <text class="expense-overview-info">共 {{expenses.length}} 笔账单</text>
          <text class="expense-overview-info" wx:if="{{lastExpenseTime}}"> · 最近更新 {{lastExpenseTime}}</text>
        </view>
      </view>

      <!-- 未设置预算时：保留原有总消费统计 -->
      <view class="expense-top-bar" wx:else>
        <view class="expense-top-actions">
          <view class="btn-primary btn-sm" bindtap="goAddExpense">添加账单</view>
          <view class="btn-secondary btn-sm {{expenseEmpty ? 'btn-disabled' : ''}}" bindtap="onCalculateSettlement">计算结算</view>
        </view>
        <view class="expense-summary">
          <text class="expense-sum-label">总消费 ¥{{expenseTotal}}</text>
          <text class="expense-sum-count" wx:if="{{!expenseEmpty}}"> · {{expenses.length}} 笔</text>
        </view>
      </view>

      <!-- 账单列表 -->
      <view class="expense-list" wx:if="{{!expenseEmpty}}">
        <view class="card expense-card expense-card-tap" wx:for="{{expenses}}" wx:key="_id" data-id="{{item._id}}" bindtap="onTapExpense">
          <view class="expense-header">
            <view class="expense-title-row">
              <text class="expense-cat-tag" wx:if="{{item.categoryLabel}}">{{item.categoryLabel}}</text>
              <text class="expense-title">{{item.title}}</text>
            </view>
            <text class="expense-amount {{item.expenseType === 'income' ? 'income-amount' : ''}}">{{item.expenseType === 'income' ? '-' : ''}}¥{{item.amountText}}</text>
          </view>
          <view class="expense-meta">
            <text>{{item.payerLabel}}：{{item.payerName}} · {{item.participantCount}} 人{{item.expenseType === 'income' ? '归属' : '分摊'}}</text>
          </view>
          <view class="expense-meta expense-date">{{item.dateText}}</view>
          <view class="expense-note" wx:if="{{item.note}}">{{item.note}}</view>
        </view>
      </view>

      <!-- 空状态 -->
      <view class="empty-state" wx:if="{{expensesLoaded && expenseEmpty}}">
        <view class="empty-state-text">暂无账单记录</view>
      </view>

      <!-- 结算：过期提示 -->
      <view class="stale-banner ui-banner ui-banner--warning" wx:if="{{settlementStale && settlementLoaded}}">
        <icon type="warn" size="16" color="#D97706" style="flex-shrink:0;margin-top:2rpx"/>
        <text style="margin-left:8rpx">账单已更新，当前结算结果可能不是最新。请重新计算。</text>
      </view>

      <!-- 结算：加载中 -->
      <view class="loading-state ui-loading" wx:if="{{settlementLoading}}">
        <view class="loading-spinner ui-loading-spinner"></view>
        <text>正在计算结算结果...</text>
      </view>

      <!-- 结算：失败 -->
      <view class="error-state ui-error" wx:elif="{{settlementError}}">
        <view class="error-state-icon"><icon type="warn" size="44" color="#E6A23C"/></view>
        <view class="error-state-text">{{settlementError}}</view>
        <view class="btn-secondary" bindtap="onCalculateSettlement">重试</view>
      </view>

      <!-- 结算：未计算 -->
      <view class="settle-placeholder" wx:elif="{{!settlementLoaded}}">
        <text>点击「计算结算」，查看当前账单的分摊结果</text>
      </view>

      <!-- 结算结果 -->
      <view class="settle-section" wx:if="{{settlementLoaded && !settlementLoading}}">
        <view class="section-title">结算结果</view>

        <!-- 无转账 -->
        <view class="card settle-card settle-done" wx:if="{{!hasSettlement}}">
          <icon type="success" size="20" color="#27AE60"/>
          <text style="margin-left:8rpx">账目已结清</text>
        </view>

        <block wx:if="{{hasSettlement}}">
        <!-- 每人收支 -->
        <view class="card settle-card" wx:for="{{balances}}" wx:key="nickName">
          <view class="settle-top">
            <text class="settle-name">{{item.nickName}}</text>
            <text class="settle-net {{item.netClass}}">{{item.netText}}</text>
          </view>
          <view class="settle-detail">
            <text>实付 ¥{{item.paidText}} · 应付 ¥{{item.shouldPayText}}</text>
          </view>
        </view>

        <!-- 转账方案 -->
        <view class="section-title" wx:if="{{transfers.length > 0}}">建议转账</view>
        <view class="card transfer-card" wx:for="{{transfers}}" wx:key="index">
          <text class="tf-from">{{item.fromName}}</text>
          <text class="tf-arrow"> → </text>
          <text class="tf-to">{{item.toName}}</text>
          <text class="tf-amount">¥{{item.amountText}}</text>
        </view>
        </block>
      </view>

      <!-- 无预算时：仅创建者可见设置入口（底部） -->
      <view class="budget-empty ui-banner" wx:if="{{budgetLoaded && !budgetSummary.hasBudget && trip.creatorOpenid === myOpenid}}">
        <text class="be-text">暂未设置预算</text>
        <text class="be-link" bindtap="goBudgetSetting">设置预算</text>
      </view>

      </block><!-- end expensesLoaded -->

    </block>

    <!-- ===== 待办 tab ===== -->
    <block wx:if="{{activeTab === 'todos'}}">

      <!-- 筛选按钮 -->
      <view class="todo-filter-bar">
        <view class="ui-segment-item {{todoFilter === item.key ? 'active' : ''}}"
              wx:for="{{todoFilterOptions}}" wx:key="key"
              data-key="{{item.key}}"
              bindtap="onTodoFilterChange">{{item.label}}</view>
      </view>

      <!-- 加载中 -->
      <view class="loading-state ui-loading" wx:if="{{todosLoading}}">
        <view class="loading-spinner ui-loading-spinner"></view>
        <text>正在加载待办...</text>
      </view>

      <!-- 加载失败 -->
      <view class="error-state ui-error" wx:elif="{{todosError}}">
        <view class="error-state-icon"><icon type="warn" size="44" color="#E6A23C"/></view>
        <view class="error-state-text">{{todosError}}</view>
        <view class="btn-secondary" bindtap="retryLoadTodos">重试</view>
      </view>

      <!-- 空状态 -->
      <view class="empty-state" wx:elif="{{todosLoaded && todoEmpty}}">
        <view class="empty-state-text" wx:if="{{todoFilter === 'unfinished'}}">所有待办已完成</view>
        <view class="empty-state-text" wx:elif="{{todoFilter === 'finished'}}">暂无已完成的待办</view>
        <view class="empty-state-text" wx:else>暂无待办事项</view>
      </view>

      <!-- 待办列表 -->
      <view class="todo-section" wx:if="{{todosLoaded && !todoEmpty}}">
        <block wx:for="{{todos}}" wx:key="_id">
          <view class="card todo-card {{item.completed ? 'todo-done' : ''}}">
            <view class="todo-header">
              <view class="todo-check" data-id="{{item._id}}" data-completed="{{item.completed}}" bindtap="toggleTodo"></view>
              <text class="todo-title">{{item.title}}</text>
              <view class="todo-del" wx:if="{{todoManaging}}" data-id="{{item._id}}" bindtap="deleteTodo"></view>
            </view>
            <view class="todo-meta">负责人：{{item.assigneeText}}</view>
            <view class="todo-meta" wx:if="{{item.dateText}}">日期：{{item.dateText}}</view>
            <view class="todo-meta todo-done-time" wx:if="{{item.completed && item.doneTime}}">完成于 {{item.doneTime}}</view>
            <view class="todo-note" wx:if="{{item.note}}">{{item.note}}</view>
          </view>
        </block>
      </view>

      <view class="tab-action" wx:if="{{!todoManaging}}">
        <view class="btn-primary" bindtap="toggleTodoManage">管理待办</view>
      </view>
      <view class="tab-action tab-action-row" wx:if="{{todoManaging}}">
        <view class="btn-primary btn-half" bindtap="goAddTodo">添加待办</view>
        <view class="btn-secondary btn-half" bindtap="toggleTodoManage">完成</view>
      </view>
    </block>

    <!-- ===== 设置 tab ===== -->
    <view class="settings-tab" wx:if="{{activeTab === 'settings'}}">

      <!-- 个人资料 -->
      <view class="set-section-title">个人资料</view>
      <view class="card profile-card" bindtap="openProfileModal">
        <view class="profile-avatar-wrap">
          <image class="profile-avatar" wx:if="{{profileAvatarUrl}}" src="{{profileAvatarUrl}}" mode="aspectFill" binderror="onProfileAvatarError"></image>
          <view class="member-avatar-placeholder" wx:else>{{user.nickName ? user.nickName[0] : '?'}}</view>
        </view>
        <view class="profile-info">
          <text class="profile-name">{{user.nickName || '旅友????'}}</text>
          <text class="profile-hint">修改昵称和头像</text>
        </view>
      </view>

      <!-- 成员列表 -->
      <view class="set-section-title">旅行成员</view>
      <view class="card member-card" wx:for="{{members}}" wx:key="openid">
        <view class="member-avatar-wrap">
          <image class="member-avatar-img" wx:if="{{item.avatarUrl}}" src="{{item.avatarUrl}}" mode="aspectFill" binderror="onMemberAvatarError" data-index="{{index}}"></image>
          <view class="member-avatar-placeholder" wx:else>{{item.firstChar}}</view>
        </view>
        <view class="member-info">
          <text class="member-name">{{item.nickName}}</text>
          <text class="member-badge" wx:if="{{item.isCreator}}">创建者</text>
          <text class="member-me" wx:if="{{item.openid === myOpenid}}">我</text>
        </view>
        <text class="member-remove-btn" wx:if="{{trip.creatorOpenid === myOpenid && item.openid !== myOpenid}}" data-openid="{{item.openid}}" catchtap="onRemoveMember">移除</text>
      </view>

      <!-- 旅行管理 -->
      <view class="set-section-title">旅行管理</view>

      <!-- 创建者看到：解散旅行 -->
      <view class="card danger-card" wx:if="{{trip.creatorOpenid === myOpenid}}">
        <view class="danger-desc">你是本次旅行的创建者，可以解散该旅行。</view>
        <view class="danger-desc">解散后，所有成员都无法继续访问该旅行。</view>
        <view class="btn-danger" bindtap="onDissolveTrip">解散旅行</view>
      </view>

      <!-- 普通成员看到：退出旅行 -->
      <view class="card danger-card" wx:if="{{trip.creatorOpenid !== myOpenid}}">
        <view class="danger-desc">你可以退出本次旅行。退出后，该旅行将不再显示在你的旅行列表中。</view>
        <view class="btn-danger" bindtap="onLeaveTrip">退出旅行</view>
      </view>

      <!-- 邀请码 -->
      <view class="set-section-title">邀请成员</view>
      <view class="card invite-card" bindtap="copyInviteCode">
        <text class="invite-code-text">{{trip.inviteCode}}</text>
        <text class="invite-hint">点击复制邀请码</text>
      </view>

      <!-- 切换旅行 -->
      <view class="set-section-title" wx:if="{{myTrips.length > 0}}">切换旅行</view>
      <view class="card switch-card" wx:for="{{myTrips}}" wx:key="_id" data-id="{{item._id}}" bindtap="switchToTrip">
        <text class="switch-name">{{item.name}}</text>
        <text class="switch-detail">{{item.destination}} · {{item.startDate}} 至 {{item.endDate}}</text>
      </view>

    </view>

  </scroll-view>

  <!-- 底部菜单栏 -->
  <view class="bottom-bar">
    <view class="tab-item {{activeTab === item.key ? 'active' : ''}}"
          wx:for="{{tabs}}" wx:key="key"
          data-key="{{item.key}}"
          bindtap="switchTab">
      <image class="tab-icon" src="{{activeTab === item.key ? item.iconActive : item.icon}}" mode="aspectFit"/>
      <text class="tab-label">{{item.label}}</text>
    </view>
  </view>

</view>

<view class="page-loading ui-page-loading" wx:if="{{loading}}">
  <view class="loading-spinner ui-loading-spinner"></view>
  <text>加载中...</text>
</view>

<view class="page-error" wx:elif="{{!trip}}">
  <view class="page-error-icon"><icon type="warn" size="52" color="#E6A23C"/></view>
  <view class="page-error-text">旅行信息加载失败，请返回重试</view>
  <view class="btn-primary" bindtap="loadTrip">重新加载</view>
</view>

<!-- 资料编辑弹窗 -->
<view class="modal-mask" wx:if="{{showProfileModal}}" catchtap="closeProfileModal"></view>
<view class="modal-panel" wx:if="{{showProfileModal}}">
  <view class="modal-title">完善个人资料</view>
  <view class="modal-desc">设置昵称和头像后，同行成员可以更容易识别你。</view>

  <!-- 头像选择：view 做展示层，button 透明覆盖在上面 -->
  <view class="avatar-picker-wrap">
    <image class="avatar-preview" wx:if="{{profileAvatarUrl}}" src="{{profileAvatarUrl}}" mode="aspectFill" binderror="onProfileAvatarError"></image>
    <view class="avatar-placeholder" wx:else>
      <text>选择头像</text>
    </view>
    <button class="avatar-picker-btn" plain="{{true}}" hover-class="none" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar"></button>
  </view>

  <!-- 昵称输入 -->
  <view class="modal-input-wrap">
    <input class="modal-input"
           type="nickname"
           placeholder="请输入昵称"
           value="{{profileNickName}}"
           maxlength="{{20}}"
           bindinput="onProfileNickInput"/>
  </view>

  <!-- 按钮 -->
  <view class="modal-actions">
    <view class="btn-primary" bindtap="saveProfile">保存</view>
    <view class="btn-secondary" bindtap="closeProfileModal">暂不设置</view>
  </view>
</view>