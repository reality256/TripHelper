/* pages/schedule-map/schedule-map.wxss */
.container { padding-bottom: 40rpx; }

.date-bar {
  padding: 20rpx 24rpx;
  background: #FFF;
  border-bottom: 1rpx solid #F0F0F0;
}

.date-picker-btn {
  display: inline-block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
  padding: 8rpx 16rpx;
  background: #F5F7F6;
  border-radius: 12rpx;
}

.route-map { width: 100%; height: 600rpx; display: block; }

.route-summary { padding: 24rpx 28rpx; }

.rs-title { font-size: 30rpx; font-weight: 600; color: #1A1A1A; margin-bottom: 8rpx; }

.rs-stats { font-size: 26rpx; color: #666; margin-bottom: 6rpx; }

.rs-missing { font-size: 24rpx; color: #E67E22; margin-top: 6rpx; }

.empty-state { padding: 60rpx 32rpx; text-align: center; font-size: 28rpx; color: #BBB; }

.loc-list { padding: 0 24rpx; }

.loc-item { display: flex; align-items: flex-start; padding: 20rpx 0; border-bottom: 1rpx solid #F5F5F5; }

.loc-idx {
  width: 44rpx; height: 44rpx; border-radius: 50%;
  background: var(--primary); color: #FFF; font-size: 24rpx; font-weight: 600;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0; margin-right: 16rpx;
}

.loc-info { flex: 1; }

.loc-title { font-size: 28rpx; display: block; }

.loc-time { font-size: 24rpx; color: #888; display: block; }

.loc-detail { font-size: 24rpx; color: #BBB; display: block; margin-top: 2rpx; }

.loading { display: flex; justify-content: center; padding-top: 200rpx; font-size: 28rpx; color: #999; }

.error-state { padding: 100rpx 32rpx; text-align: center; font-size: 28rpx; color: #999; }
