/* pages/schedule-map/schedule-map.wxss */
.container { padding-bottom: 40rpx; }

.date-bar {
  padding: 20rpx 24rpx;
  background: #FFF;
  border-bottom: 1rpx solid #F0F0F0;
}

.date-picker-btn {
  display: inline-block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
  padding: 8rpx 16rpx;
  background: #F5F7F6;
  border-radius: 12rpx;
}

.route-map { width: 100%; height: 600rpx; display: block; }

.route-summary { padding: 24rpx 28rpx; }

.rs-title { font-size: 30rpx; font-weight: 600; color: #1A1A1A; margin-bottom: 8rpx; }

/* 路线统计：flex 图标+文字布局 */
.rs-stats {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 6rpx;
}

.rs-stat {
  display: flex;
  align-items: center;
}

.rs-stat + .rs-stat { margin-left: 16rpx; }

.rs-stat-icon {
  width: 26rpx;
  height: 26rpx;
  flex-shrink: 0;
  margin-right: 4rpx;
}

.rs-missing { font-size: 24rpx; color: #E67E22; margin-top: 6rpx; display: flex; align-items: flex-start; }

/* 空状态（ui-empty 提供基础样式，此处仅覆盖地图页特有间距） */
.empty-state { padding-top: 60rpx; }

.loc-list { padding: 0 24rpx; }

.loc-item { display: flex; align-items: flex-start; padding: 20rpx 0; border-bottom: 1rpx solid #F5F5F5; }

.loc-idx {
  width: 44rpx; height: 44rpx; border-radius: 50%;
  background: var(--primary); color: #FFF; font-size: 24rpx; font-weight: 600;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0; margin-right: 16rpx;
}

.loc-info { flex: 1; }

.loc-title { font-size: 28rpx; display: block; }

.loc-time { font-size: 24rpx; color: #888; display: block; }

.loc-detail { font-size: 24rpx; color: #BBB; display: block; margin-top: 2rpx; }

