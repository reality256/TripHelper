/* pages/expenses/expenses.wxss */

/* 总金额 */
.total-card {
  text-align: center;
  padding: 40rpx 32rpx;
}

.total-label {
  font-size: 26rpx;
  color: #999;
}

.total-amount {
  font-size: 56rpx;
  font-weight: 700;
  color: var(--primary);
  margin-top: 8rpx;
}

/* 账单列表 */
.expense-list {
  margin-bottom: 32rpx;
}

.expense-card {
  padding: 28rpx 32rpx;
}

.expense-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.expense-title {
  font-size: 30rpx;
  font-weight: 500;
  flex: 1;
}

.expense-amount {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--primary);
  flex-shrink: 0;
  margin-left: 24rpx;
}

.expense-meta {
  font-size: 24rpx;
  color: #999;
}

.expense-date-sep {
  margin: 0 8rpx;
}

.expense-note {
  font-size: 24rpx;
  color: #BBB;
  margin-top: 8rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #F5F5F5;
}
