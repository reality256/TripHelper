<!--pages/addItinerary/addItinerary.wxml-->
<view class="container">
  <!-- 加载中 -->
  <view class="loading ui-loading" wx:if="{{loading}}"><text>加载中...</text></view>

  <!-- 编辑模式加载失败：禁止提交，提供重试 -->
  <view class="error-state ui-error" wx:elif="{{loadError}}">
    <view class="error-state-icon"><icon type="warn" size="44" color="#E6A23C"/></view>
    <view class="error-state-text">{{loadError}}</view>
    <view class="btn-secondary" bindtap="loadItineraryDetail">重试</view>
  </view>

  <block wx:else>
  <view class="page-title">{{isEdit ? '编辑行程' : '添加行程'}}</view>

  <view class="card">
    <view class="form-group">
      <view class="form-label">行程标题</view>
      <input class="form-input" placeholder="例如：参观大熊猫基地" value="{{title}}" bindinput="onTitleInput" maxlength="50"/>
    </view>
    <view class="form-group">
      <view class="form-label">日期</view>
      <picker mode="date" value="{{date}}" bindchange="onDateChange">
        <view class="form-input" style="line-height:88rpx">{{date || '请选择日期'}}</view>
      </picker>
    </view>
    <view class="form-group">
      <view class="form-label">地点</view>
      <!-- 已选地图地点 -->
      <view class="location-card" wx:if="{{hasMapLocation}}" bindtap="onChooseLocation">
        <view class="loc-name">{{locationName}}</view>
        <view class="loc-addr" wx:if="{{locationAddress}}">{{locationAddress}}</view>
        <view class="loc-hint">点击重新选择</view>
      </view>
      <!-- 未选：点击选址 -->
      <view class="location-picker" wx:else bindtap="onChooseLocation">
        <image class="loc-picker-icon" src="/images/icons/location.svg" mode="aspectFit"/>
        <text class="loc-picker-text">点击选择地图地点</text>
        <view class="loc-picker-arrow"></view>
      </view>
      <view class="loc-clear" wx:if="{{hasMapLocation}}" catchtap="onClearLocation">清除地点</view>
    </view>
    <view class="form-group">
      <view class="form-label">开始时间</view>
      <picker mode="time" value="{{startTime}}" bindchange="onStartTimeChange">
        <view class="form-input" style="line-height:88rpx">{{startTime || '请选择'}}</view>
      </picker>
    </view>
    <view class="form-group">
      <view class="form-label">结束时间</view>
      <picker mode="time" value="{{endTime}}" bindchange="onEndTimeChange">
        <view class="form-input" style="line-height:88rpx">{{endTime || '请选择'}}</view>
      </picker>
    </view>
    <view class="form-group">
      <view class="form-label">备注</view>
      <textarea class="form-input" style="height:120rpx;padding:16rpx 24rpx" placeholder="选填" value="{{note}}" bindinput="onNoteInput" maxlength="200"/>
    </view>
  </view>

  <view class="btn-primary {{submitting ? 'btn-disabled' : ''}}" bindtap="onSubmit">{{submitting ? '提交中...' : (isEdit ? '保存修改' : '确认添加')}}</view>
  </block>
</view>
