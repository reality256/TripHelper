/* pages/addItinerary/addItinerary.wxss */

.page-title { margin-bottom: 40rpx; }
.card { margin-bottom: 56rpx; }

/* 地图选址 */
.location-picker {
  display: flex;
  align-items: center;
  background: #F5F7F6;
  border: 2rpx dashed #D0D0D0;
  border-radius: 14rpx;
  padding: 28rpx 24rpx;
}

.location-picker:active { background: #EEF0EF; }

/* 地图选址图标（SVG image 替代 Emoji） */
.loc-picker-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.loc-picker-text {
  flex: 1;
  font-size: 28rpx;
  color: #BBB;
}

/* CSS chevron 替代 Emoji 箭头 */
.loc-picker-arrow {
  width: 16rpx;
  height: 16rpx;
  border-right: 3rpx solid #CCC;
  border-top: 3rpx solid #CCC;
  transform: rotate(45deg);
  flex-shrink: 0;
  margin-left: 12rpx;
}

/* 已选地点卡片 */
.location-card {
  background: #F0FAF7;
  border: 2rpx solid #C8E6C9;
  border-radius: 14rpx;
  padding: 24rpx 28rpx;
}

.location-card:active { background: #E8F5F3; }

.loc-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #1A1A1A;
  margin-bottom: 4rpx;
}

.loc-addr {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 4rpx;
}

.loc-hint {
  font-size: 22rpx;
  color: #CCC;
}

.loc-clear {
  text-align: right;
  font-size: 24rpx;
  color: #E74C3C;
  padding: 10rpx 0;
}
