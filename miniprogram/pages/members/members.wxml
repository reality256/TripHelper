<!--pages/members/members.wxml-->
<view class="container">
  <view class="page-title">成员管理</view>

  <!-- 加载中 -->
  <view class="loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <block wx:if="{{!loading}}">
    <!-- 成员列表 -->
    <view class="member-list">
      <view class="card member-card" wx:for="{{members}}" wx:key="openid">
        <image class="member-avatar" src="{{item.avatarUrl || '/images/avatar.png'}}" mode="aspectFill" binderror="onAvatarError"/>
        <view class="member-info">
          <view class="member-name">
            {{item.nickName}}
            <text class="creator-badge" wx:if="{{item.isCreator}}">创建者</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 邀请码 -->
    <view class="card invite-box" bindtap="copyInviteCode">
      <text class="invite-label">邀请码</text>
      <text class="invite-code">{{inviteCode}}</text>
      <text class="invite-tip">点击复制邀请码分享给朋友</text>
    </view>
  </block>
</view>