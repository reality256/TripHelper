/* pages/members/members.wxss */

.member-list {
  margin-bottom: 32rpx;
}

.member-card {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
}

.member-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #EEE;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.member-info {
  flex: 1;
}

.member-name {
  font-size: 30rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
}

.creator-badge {
  font-size: 20rpx;
  color: var(--primary);
  border: 1rpx solid var(--primary);
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  margin-left: 12rpx;
}

/* 邀请码 */
.invite-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 32rpx;
}

.invite-box:active {
  background: #F9F9F9;
}

.invite-label {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.invite-code {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--primary);
  letter-spacing: 12rpx;
  margin-bottom: 12rpx;
}

.invite-tip {
  font-size: 24rpx;
  color: #BBB;
}
