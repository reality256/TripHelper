/**app.wxss**/

/* 全局基础 */
page {
  background: #F5F7F6;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  font-size: 28rpx;
  color: #333;
  --primary: #2A9D8F;
  --danger: #E8685A;
  --text: #1A1A1A;
  --text-secondary: #666;
  --text-hint: #999;
  --bg: #F5F7F6;
  --border: #F0F0F0;
}

button {
  background: initial;
  padding: 0;
  margin: 0;
}

button:focus {
  outline: 0;
}

button::after {
  border: none;
}

/* 页面容器 */
.container {
  padding: 40rpx 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 卡片 */
.card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

/* 页面标题 */
.page-title {
  font-size: 44rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 32rpx;
}

.page-subtitle {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 48rpx;
}

/* 主按钮 */
.btn-primary {
  width: 100%;
  height: 96rpx;
  background: var(--primary);
  border-radius: 48rpx;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 500;
  text-align: center;
  line-height: 96rpx;
}

.btn-primary:active {
  opacity: 0.85;
}

/* 次按钮 */
.btn-secondary {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: #FFFFFF;
  color: var(--primary);
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 500;
  text-align: center;
  border: 2rpx solid var(--primary);
  box-sizing: border-box;
}

/* 表单 */
.form-group {
  margin-bottom: 36rpx;
}

.form-group:last-child {
  margin-bottom: 0;
}

.form-label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 14rpx;
  font-weight: 500;
}

.form-input {
  width: 100%;
  height: 88rpx;
  background: #F5F7F6;
  border-radius: 14rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: #1A1A1A;
  box-sizing: border-box;
}

textarea.form-input {
  height: 120rpx;
  padding: 16rpx 24rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 32rpx;
}

.empty-state-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
  opacity: 0.4;
}

.empty-state-text {
  font-size: 28rpx;
  color: #999;
  text-align: center;
  line-height: 1.6;
}

/* 加载中 */
.loading {
  display: flex;
  justify-content: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}
